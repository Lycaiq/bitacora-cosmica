# =============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.
# =============================================================

# Puerto donde escucha el servidor Express
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Nivel de logs: error | warn | info | debug
LOG_LEVEL=info

# Dominio permitido para CORS (en producción pon tu dominio real)
CORS_ORIGIN=http://localhost:3000
