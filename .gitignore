# =============================================================
# Dependencies — jamás subir node_modules al repositorio
# =============================================================
node_modules/
.npm/
.yarn/
.pnp.*
.yarn-integrity

# =============================================================
# Variables de entorno — NUNCA subir credenciales
# =============================================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.p12

# =============================================================
# Logs — generados en runtime, no pertenecen al repo
# =============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
pids/
*.pid
*.seed

# =============================================================
# Build outputs — artefactos generados automáticamente
# =============================================================
dist/
build/
.cache/
.parcel-cache/
.vite/

# =============================================================
# Coverage y testing — resultados locales de tests
# =============================================================
coverage/
.nyc_output/
test-results/
*.lcov

# =============================================================
# OS y editores — basura específica del sistema operativo
# =============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================
# IDE — configuraciones locales del editor, no del proyecto
# =============================================================
.idea/
.vscode/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
.vs/

# =============================================================
# Runtime — archivos temporales de Node.js en ejecución
# =============================================================
.node_repl_history
*.tgz
.next/
out/

# =============================================================
# Databases — archivos de base de datos locales
# =============================================================
*.db
*.sqlite
*.sqlite3
db/data/

# =============================================================
# Uploads del usuario — contenido dinámico, no código
# =============================================================
uploads/
temp/
tmp/
