# ═══════════════════════════════════════════════════════════
# .npmrc — Configuración de seguridad para npm
# Bitácora Cósmica · La luna como lugar de encuentro
# ═══════════════════════════════════════════════════════════

# Auditoría automática al instalar paquetes
audit=true

# Nivel de auditoría: solo fallar en vulnerabilidades altas o críticas
audit-level=high

# Guardar exactamente las versiones (sin rangos ^)
save-exact=false

# Rechazar paquetes con scripts de ciclo de vida no declarados
ignore-scripts=false

# Verificar integridad de paquetes con lockfile
package-lock=true

# Registro por defecto (explícito)
registry=https://registry.npmjs.org/

# Tiempo de espera para solicitudes de red (ms)
fetch-timeout=30000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-retries=3
